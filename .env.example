# TERIMBERE / AgriRwanda Pro - Environment Configuration
# Copy this file to .env for local development or configure in Render Dashboard -> Environment

# Google Gemini API Key (Used server-side for AI Agronomist Advisor, AgroZone Weather Synthesis & Crop Doctor)
GEMINI_API_KEY=

# Server Port (Render automatically injects PORT in production; defaults to 3000 locally)
PORT=3000
NODE_ENV=development
